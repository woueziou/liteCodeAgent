{
  "name": "litecodeagent",
  "version": "0.10.0",
  "description": "Portable multi-agent workflows for Claude Code, Codex, Pi, OpenCode, Kilo Code, and direct API runners.",
  "type": "module",
  "bin": {
    "litecodeagent": "./bin/litecodeagent",
    "litecode": "./bin/litecode"
  },
  "files": [
    ".claude-plugin/",
    "bin/",
    "examples/",
    "packs/",
    "skills/",
    "src/",
    "CHANGELOG.md",
    "HANDOFF.md",
    "install.sh"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woueziou/liteCodeAgent.git"
  },
  "homepage": "https://github.com/woueziou/liteCodeAgent#readme",
  "bugs": "https://github.com/woueziou/liteCodeAgent/issues",
  "keywords": [
    "agents",
    "multi-agent",
    "claude-code",
    "codex",
    "pi",
    "opencode",
    "kilo-code",
    "openai",
    "developer-tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "litecode": "bun run src/cli.ts",
    "check": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
